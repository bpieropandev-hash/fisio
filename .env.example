# Physio Manager - exemplo de configuração
# Copie para .env e ajuste os valores. NUNCA commite o arquivo .env.

# ============================================
# Banco de Dados (PostgreSQL)
# ============================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/physio_manager
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin_password

# ============================================
# JPA/Hibernate
# ============================================
# Manter validate: o schema é gerenciado pelas migrações em db/migration
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
# Schema usado pela aplicação (produção e dev usam "master")
SPRING_JPA_PROPERTIES_HIBERNATE_DEFAULT_SCHEMA=master
SPRING_JPA_PROPERTIES_HIBERNATE_JDBC_TIME_ZONE=America/Sao_Paulo

# ============================================
# Segurança (OBRIGATÓRIA - a aplicação não sobe sem isso)
# ============================================
# Mínimo 32 caracteres. Gere um valor aleatório forte, ex.:
#   openssl rand -base64 48
API_SECURITY_TOKEN_SECRET=

# ============================================
# CORS
# ============================================
# Lista separada por vírgula. Em produção, use a origem do frontend.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ============================================
# Opcionais (defaults sensatos no application.properties)
# ============================================
# SERVER_PORT=8080
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
# LOGGING_LEVEL_COM_PHYSIO=INFO
# LOGGING_LEVEL_ORG_HIBERNATE_SQL=WARN
# JAVA_OPTS=-Xmx1024m -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
